# Twitter Authentication
# Required for password-based authentication
TWITTER_USERNAME=your_username
TWITTER_PASSWORD=your_password
TWITTER_EMAIL=your_email@example.com

# Optional: TOTP secret for 2FA (base32 encoded)
# TWITTER_2FA_SECRET=JBSWY3DPEHPK3PXP

# Optional: JSON-serialized array of cookies from an authenticated session
# Using cookies is recommended over password auth for reliability
# To get cookies: Log into x.com, open DevTools → Application → Cookies → https://x.com
# Key cookies needed: auth_token, ct0, twid
# Format: Array of objects with key, value, domain, path properties
# TWITTER_COOKIES='[{"key":"auth_token","value":"your_auth_token","domain":".x.com","path":"/"},{"key":"ct0","value":"your_csrf_token","domain":".x.com","path":"/"},{"key":"twid","value":"u%3Dyour_user_id","domain":".x.com","path":"/"}]'

# Optional: HTTP(s) proxy URL for requests
# PROXY_URL=http://localhost:8080

# ============================================
# Official API Server Configuration (Optional)
# ============================================
# These credentials are required if you wish to use the official Twitter API v2
# instead of the internal scraping logic.
#
# Method A: Bearer Token (App-only auth, higher rate limits for search)
# TWITTER_BEARER_TOKEN=your_bearer_token
#
# Method B: OAuth 1.0a (User context, required for some endpoints)
# TWITTER_API_KEY=your_consumer_key
# TWITTER_API_SECRET=your_consumer_secret
# TWITTER_ACCESS_TOKEN=your_access_token
# TWITTER_ACCESS_SECRET=your_access_token_secret
